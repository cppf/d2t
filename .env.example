# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# .env is already in .gitignore - it will never be committed.
# Never share these values or paste them into a chat with anyone.

# ---------------------------------------------------------------------
# From https://my.telegram.org -> log in -> "API development tools"
# -> create an app (any name is fine) -> copy the values it gives you
# ---------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---------------------------------------------------------------------
# The chat/channel to send files to. Leave blank until you've run:
#     docker compose run --rm app python3 drive_to_telegram.py --list-chats
# which will print your chats with their IDs - copy the right one here.
# ---------------------------------------------------------------------
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# The public Google Drive folder to copy files from. Must be shared as
# "Anyone with the link" (Drive -> right-click folder -> Share ->
# General access -> Anyone with the link).
# ---------------------------------------------------------------------
GDRIVE_FOLDER_URL=

# ---------------------------------------------------------------------
# Optional. Telegram's send limit for regular accounts is 2048 MB
# (2 GB). If your account has Telegram Premium, that limit is 4096 MB
# (4 GB) - uncomment and change the line below if so.
# ---------------------------------------------------------------------
# MAX_UPLOAD_MB=4096

# ---------------------------------------------------------------------
# Optional. Defaults to true: each file is deleted from local storage
# right after it's confirmed sent, so at most one file's worth of disk
# space is used at a time instead of the whole batch piling up. Files
# that FAIL to send are always kept regardless of this setting, so you
# can retry without re-downloading. Set to false to keep every local
# copy - only worth doing if you've set up persistent storage (see
# README's "Making the session persist" section) and actually want the
# files kept around afterward.
# ---------------------------------------------------------------------
# DELETE_AFTER_SEND=false

# ---------------------------------------------------------------------
# Duplicate protection
# ---------------------------------------------------------------------
# Check the destination Telegram chat before uploading.
# The script skips a file only when both filename AND byte size match.
CHECK_DESTINATION=true

# Persistent paths inside the Docker volume.
DOWNLOAD_DIR=/app/data/drive_downloads
TELEGRAM_SESSION=/app/data/drive_to_telegram_session
