# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# .env is already in .gitignore - it will never be committed.
# Never share these values or paste them into a chat with anyone.

# ---------------------------------------------------------------------
# From https://my.telegram.org -> log in -> "API development tools"
# -> create an app (any name is fine) -> copy the values it gives you
# ---------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---------------------------------------------------------------------
# The chat/channel to send files to. Leave blank until you've run:
#     docker compose run --rm app --list-chats
# which will print your chats with their IDs - copy the right one here.
# ---------------------------------------------------------------------
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# The public Google Drive folder to copy files from. Must be shared as
# "Anyone with the link" (Drive -> right-click folder -> Share ->
# General access -> Anyone with the link).
# ---------------------------------------------------------------------
GDRIVE_FOLDER_URL=

# ---------------------------------------------------------------------
# Optional. Telegram's send limit for regular accounts is 2048 MB
# (2 GB). If your account has Telegram Premium, that limit is 4096 MB
# (4 GB) - uncomment and change the line below if so.
# ---------------------------------------------------------------------
# MAX_UPLOAD_MB=4096

# ---------------------------------------------------------------------
# Optional. Defaults to true: each file is deleted from local storage
# right after it's confirmed sent (or confirmed already in the
# destination), so at most one file's worth of disk space is used at a
# time. Files that FAIL to send are always kept regardless of this
# setting, so the next run can retry them without re-downloading from
# Drive. Set to false only if you actually want every local copy kept
# around after a successful upload too.
# ---------------------------------------------------------------------
# DELETE_AFTER_SEND=false

# ---------------------------------------------------------------------
# Duplicate protection
# ---------------------------------------------------------------------
# Check the destination Telegram chat before uploading.
# The script skips a file only when both filename AND byte size match.
CHECK_DESTINATION=true

# Persistent paths inside the Docker volume.
DOWNLOAD_DIR=/app/data/drive_downloads
THUMB_DIR=/app/data/thumbnails
TELEGRAM_SESSION=/app/data/drive_to_telegram_session

# ---------------------------------------------------------------------
# Pipeline behavior. Files are always processed ONE AT A TIME:
# download -> upload -> delete -> next file.
# ---------------------------------------------------------------------

# How many times to retry a single Drive download if it fails (e.g. Drive
# is rate-limiting anonymous downloads). Each retry waits longer than the
# last (exponential backoff), capped at 10 minutes per wait.
DOWNLOAD_RETRIES=5

# The base wait (seconds) before the first retry. Doubles each subsequent
# attempt: 20s, 40s, 80s, 160s, ...
DOWNLOAD_RETRY_BASE_SECONDS=20

# Pause (seconds) between finishing one file and starting the next. This
# is the main defense against Google Drive rate-limiting/blocking your
# access after a handful of videos - it keeps requests spaced out instead
# of hammering Drive back-to-back. Increase this (e.g. to 20-30) if you
# still see Drive errors.
PAUSE_BETWEEN_FILES_SECONDS=8

# Where in the video (seconds) to grab the thumbnail frame from. Frame 0
# is often black on many encoders, so this defaults to 1 second in -
# matching what Telegram's own client does on a manual upload.
THUMBNAIL_OFFSET_SECONDS=1

# Set to true to disable ANSI colors in the log output (e.g. if your
# terminal/log viewer does not render them well).
# NO_COLOR=true
